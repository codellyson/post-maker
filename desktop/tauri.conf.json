{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Post maker",
  "version": "0.1.0",
  "identifier": "com.kreativekorna.post-maker",
  "build": {
    "frontendDist": "loading",
    "beforeBuildCommand": "sh desktop/stage-engine.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Post maker",
        "url": "index.html",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "engine/": "engine/"
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdENzE1M0Y3MDQ5N0JBMkEKUldRcXVwY0U5MU54ZmRUNnh5R3BQRmNJdXhrY1JEYmdmaUk3SmU0Z0tnUEh1aDU3em5JaUN4RXkK",
      "endpoints": [
        "https://github.com/codellyson/post-maker/releases/latest/download/latest.json"
      ]
    }
  }
}
